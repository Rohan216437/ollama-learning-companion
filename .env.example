# Flask
FLASK_SECRET_KEY=change-this-to-a-random-secret-string
FLASK_DEBUG=True

# Database
# Leave DATABASE_URL unset to use the built-in SQLite file (instance/learning_companion.db).
# To migrate to MySQL later, uncomment and set something like:
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/learning_companion

# Local Ollama AI
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0.2
OLLAMA_MAX_TRANSCRIPT_CHARS=45000
